{
  "version": 2,
  "builds": [
    {
      "src": "erp_api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "erp_frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "erp_api/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "erp_frontend/$1"
    }
  ]
}
