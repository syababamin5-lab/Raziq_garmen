{
  "hosting": {
    "public": "erp_frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".venv"
      ]
    },
    {
      "source": "functions_py",
      "codebase": "python",
      "ignore": [
        ".venv",
        "__pycache__"
      ]
    }
  ]
}
